rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == userId;
      match /friends/{friendId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null
          && request.resource.data.nickname is string
          && request.resource.data.birthday is string
          && request.resource.data.friendCode is string;
        allow update: if request.auth != null
          && (request.auth.uid == userId
            || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.friendCode == resource.data.friendCode);
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
      match /receivedCards/{cardId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null
          && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.recipientId == userId;
        allow update, delete: if request.auth != null && request.auth.uid == userId;
      }
    }
    match /cards/{cardId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 240;
      allow update, delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
    }
  }
}
